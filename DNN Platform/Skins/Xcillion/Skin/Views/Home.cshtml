@using DotNetNuke.Web.MvcPipeline.Models
@using DotNetNuke.Web.MvcPipeline.Skins
@using DotNetNuke.Web.DDRMenu
@model PageModel

@section head {
    @Html.Meta(name: "viewport", content: "width=device-width,initial-scale=1")
}

<!--[if lt IE 9]>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.2/html5shiv.min.js"></script>
    <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
<![endif]-->

<div id="siteWrapper">
    <!-- UserControlPanel  -->
    <div id="topHeader">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div id="search-top" class="pull-right small-screens hidden-sm hidden-md hidden-lg">
                        @*<dnn:SEARCH ID="dnnSearch2" runat="server" ShowSite="false" ShowWeb="false" EnableTheming="true" Submit="Search" CssClass="SearchButton" />*@
                        @Html.Search(id: "dnnSearch2", showSite: false, showWeb: false, submit: "Search", cssClass: "SearchButton")
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="language">
                        @Html.Language(showMenu: false, showLinks: true)
                    </div>
                    <div class="search hidden-xs">
                        @*<dnn:SEARCH ID="dnnSearch" runat="server" ShowSite="false" ShowWeb="false" EnableTheming="true" Submit="Search" CssClass="SearchButton" />*@
                        @Html.Search(id: "dnnSearch", showSite: false, showWeb: false, submit: "Search", cssClass: "SearchButton")
                    </div>
                    <a id="search-action" aria-label="Search"></a>
                    <div id="login" class="pull-right">
                        @Html.Login(cssClass: "LoginLink", legacyMode: false)
                        @Html.User(legacyMode: false)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Header -->
    <header role="banner">
        <div id="mainHeader-inner" class="container">
            <div class="clearfix"></div>
            <div class="navbar navbar-default" role="navigation">
                <div id="navbar-top-wrapper">
                    <div id="logo">
                        <span class="brand">
                            @Html.Logo()
                        </span>
                    </div>
                </div>
                <!-- Brand and toggle get grouped for better mobile display -->
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                </div>
                <div id="navbar" class="collapse navbar-collapse pull-right">
                    @Html.DDRMenu(clientID: "MENU", menuStyle: "Menus/MainMenu")
                </div>
            </div>
        </div>
    </header>

    <!-- Page Content -->
    <div class="container">
        <main role="main">
            <div class="row dnnpane">
                @Html.Pane(id: "headerpane", cssClass: "col-md-12 headerPane")
            </div>
            <div id="mainContent-inner">
                <div class="row dnnpane">
                    @Html.Pane(id: "contentpane", cssClass: "col-md-12 contentPane")
                </div>

                <div class="row dnnpane">
                    @Html.Pane(id: "p1_75_1", cssClass: "col-md-8 spacingTop")
                    @Html.Pane(id: "p1_25_2", cssClass: "col-md-4 spacingTop")
                </div>

                <div class="row dnnpane">
                    @Html.Pane(id: "p2_25_1", cssClass: "col-md-4 spacingTop")
                    @Html.Pane(id: "p2_75_2", cssClass: "col-md-8 spacingTop")
                </div>

                <div class="row dnnpane">
                    @Html.Pane(id: "p3_33_1", cssClass: "col-md-4 spacingTop")
                    @Html.Pane(id: "p3_33_2", cssClass: "col-md-4 spacingTop")
                    @Html.Pane(id: "p3_33_3", cssClass: "col-md-4 spacingTop")
                </div>

                <div class="row dnnpane">
                    @Html.Pane(id: "contentpanelower", cssClass: "col-md-12 contentPane spacingTop")
                </div>
            </div><!-- /.mainContent-inner -->
        </main>
        <!-- /.mainContent -->
    </div>
    <!-- /.container -->
    <!-- Footer -->
    <footer role="contentinfo">
        <div class="footer-above">
            <div class="container">
                <div class="row dnnpane">
                    @Html.Pane(id: "footer_25_1", cssClass: "footer-col col-md-3 col-sm-6")
                    @Html.Pane(id: "footer_25_2", cssClass: "footer-col col-md-3 col-sm-6")
                    <div class="clearfix visible-sm"></div>
                    @Html.Pane(id: "footer_25_3", cssClass: "footer-col col-md-3 col-sm-6")
                    @Html.Pane(id: "footer_25_4", cssClass: "footer-col col-md-3 col-sm-6")
                </div>
            </div>
        </div>
        <div class="footer-below">
            <div class="container">
                <div class="row dnnpane">
                    <div class="col-md-12">
                        <div class="copyright">
                            @Html.Copyright(cssClass: "")
                        </div>
                        <div class="terms-priv">
                            @Html.LinkToMobileSite()
                            @Html.Terms()
                            |
                            @Html.Privacy()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>
</div>
<!-- /.SiteWrapper -->
@* CSS & JS includes *@
@Html.SkinPartial("Common/AddFiles")