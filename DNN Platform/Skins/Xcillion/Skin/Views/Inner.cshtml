@using DotNetNuke.Web.Mvc.Skins
@using DotNetNuke.Web.DDRMenu
@model DotNetNuke.Framework.Models.PageModel

@{
    Model.ContentSecurityPolicy.AddFontSource(DotNetNuke.Web.Mvc.Csp.CspSourceType.Host, "https://fonts.gstatic.com");
    // Model.ContentSecurityPolicy.AddStyleSource(DotNetNuke.Web.Mvc.Csp.CspSourceType.Inline);
    Model.ContentSecurityPolicy.AddScriptSource(DotNetNuke.Web.Mvc.Csp.CspSourceType.StrictDynamic);
    // Model.ContentSecurityPolicy.AddScriptSource(DotNetNuke.Web.Mvc.Csp.CspSourceType.Inline); // for backward compatibility
}

@section metas {
    <link rel="preconnect" href="https://fonts.gstatic.com">
    @*<dnn:META ID="META1" runat="server" Name="viewport" Content="width=device-width,initial-scale=1" />*@
    @Html.Meta(name: "viewport", content: "width=device-width,initial-scale=1")
    @*<meta http-equiv="Content-Security-Policy" content="default-src 'self';base-uri 'self';form-action 'self';object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline' ;font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' 'nonce-@(Model.Nonce)' ;">*@
}
<!--[if lt IE 9]>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.2/html5shiv.min.js"></script>
<![endif]-->

<div id="siteWrapper">
    <!--Tob bar -->
    <div id="topHeader">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div id="search-top" class="pull-right small-screens hidden-sm hidden-md hidden-lg">
                        @*<dnn:SEARCH ID="dnnSearch2" runat="server" ShowSite="false" ShowWeb="false" EnableTheming="true" Submit="Search" CssClass="SearchButton" />*@
                        @Html.Search(id: "dnnSearch2", showSite: false, showWeb: false, submit: "Search", cssClass: "SearchButton")
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="language">
                        @*<dnn:LANGUAGE runat="server" ID="LANGUAGE1" ShowMenu="False" ShowLinks="True" />*@
                        @Html.Language(showMenu: false, showLinks: true)
                    </div>
                    <div class="search hidden-xs">
                        @*<dnn:SEARCH ID="dnnSearch" runat="server" ShowSite="false" ShowWeb="false" EnableTheming="true" Submit="Search" CssClass="SearchButton" />*@
                        @Html.Search(id: "dnnSearch", showSite: false, showWeb: false, submit: "Search", cssClass: "SearchButton")
                    </div>
                    <!-- search action for Search function on small devices -->
                    <a id="search-action" aria-label="Search" role="search"></a>
                    <div id="login" class="pull-right">
                        @*<dnn:LOGIN ID="dnnLogin" CssClass="LoginLink" runat="server" LegacyMode="false" />*@
                        @Html.Login(cssClass: "LoginLink", legacyMode: false)
                        @*<dnn:USER ID="dnnUser" runat="server" LegacyMode="false" />*@
                        @Html.User(legacyMode: false)
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--Header -->
    <header role="banner">
        <div id="mainHeader-inner" class="container">
            <div class="navbar navbar-default" role="navigation">
                <div id="navbar-top-wrapper">
                    <div id="logo">
                        <span class="brand">
                            @* <dnn:LOGO runat="server" ID="dnnLOGO" /> *@
                            @Html.Logo()
                        </span>
                    </div>
                </div>
                <!-- Brand and toggle get grouped for better mobile display -->
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                </div>
                <div id="navbar" class="collapse navbar-collapse pull-right">
                    @*
                        <dnn:MENU ID="MENU" MenuStyle="Menus/MainMenu" runat="server" NodeSelector="*"></dnn:MENU>
                    *@
                    @Html.DDRMenu(clientID: "MENU", menuStyle: "Menus/MainMenu")
                </div>
            </div>
        </div>
    </header>
    <!-- Page Content -->
    <div class="container">
        <main role="main">
            <div class="row dnnpane">
                <div id="HeaderPane" class="col-md-12 headerPane">@Html.Pane("headerpane")</div>
            </div>
            <div id="breadcrumb" class="col-md-12">
                @*<dnn:BREADCRUMB ID="dnnBreadcrumb" runat="server" CssClass="breadcrumbLink" RootLevel="0" Separator="&lt;img src=&quot;/Portals/_default/Skins/Xcillion/Images/breadcrumb-arrow.png&quot; alt=&quot;breadcrumb separator&quot;&gt;" HideWithNoBreadCrumb="true" />*@
                @Html.BreadCrumb(cssClass: "breadcrumbLink",
                                    rootLevel: 0,
                                    separator: "<img src=\"/Portals/_default/Skins/Xcillion/Images/breadcrumb-arrow.png\" alt=\"breadcrumb separator\" width=\"4\" height=\"9\" />",
                                    hideWithNoBreadCrumb: true)
            </div>
            <div id="mainContent-inner">
                <div class="row dnnpane">
                    <div id="ContentPane" class="col-md-12 contentPane ">@Html.Pane("contentpane")</div>
                </div>
                <div class="row dnnpane">
                    <div id="P1_75_1" class="col-md-8 leftPane spacingTop ">@Html.Pane("p1_75_1")</div>
                    <div id="P1_25_2" class="col-md-4 rightPane spacingTop " runat="server">@Html.Pane("p1_25_2")</div>
                </div>
                <div class="row dnnpane">
                    <div id="P2_25_1" class="col-md-4 spacingTop ">@Html.Pane("p2_25_1")</div>
                    <div id="P2_75_2" class="col-md-8 spacingTop ">@Html.Pane("p2_75_2")</div>
                </div>
                <div class="row dnnpane">
                    <div id="P3_33_1" class="col-md-4 spacingTop ">@Html.Pane("p3_33_1")</div>
                    <div id="P3_33_2" class="col-md-4 spacingTop ">@Html.Pane("p3_33_2")</div>
                    <div id="P3_33_3" class="col-md-4 spacingTop ">@Html.Pane("p3_33_3")</div>
                </div>
                <div class="row dnnpane">
                    <div id="ContentPaneLower" class="col-md-12 contentPane spacingTop ">@Html.Pane("contentpanelower")</div>
                </div>
            </div><!-- /.mainContent-inner -->
        </main>
        <!-- /.mainContent -->
    </div>
    <!-- /.container -->
    <!-- Footer -->
    <footer role="contentinfo">
        <div class="footer-above">
            <div class="container">
                <div class="row dnnpane">
                    <div id="footer_25_1" class="footer-col col-md-3 col-sm-6" runat="server">@Html.Pane("footer_25_1")</div>
                    <div id="footer_25_2" class="footer-col col-md-3 col-sm-6" runat="server">@Html.Pane("footer_25_2")</div>
                    <div class="clearfix visible-sm"></div>
                    <div id="footer_25_3" class="footer-col col-md-3 col-sm-6" runat="server">@Html.Pane("footer_25_3")</div>
                    <div id="footer_25_4" class="footer-col col-md-3 col-sm-6" runat="server">@Html.Pane("footer_25_4")</div>
                </div>
            </div>
        </div>
        <div class="footer-below">
            <div class="container">
                <div class="row dnnpane">
                    <div class="col-md-12">
                        <div class="copyright">
                            @*<dnn:COPYRIGHT ID="dnnCopyright" runat="server" CssClass="" />*@
                            @Html.Copyright(cssClass: "")
                        </div>
                        <div class="terms-priv">
                            @*<dnn:LINKTOMOBILE ID="dnnLinkToMobile" runat="server" />*@
                            @Html.LinkToMobileSite()
                            @*<dnn:TERMS ID="dnnTerms" runat="server" />*@
                            @Html.Terms()
                            |
                            @Html.Privacy()
                            @*<dnn:PRIVACY ID="dnnPrivacy" runat="server" />*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>
</div>

@* CSS & JS includes *@
@Html.SkinPartial("Common/AddFiles")

@{
    Context.Response.AddHeader("Content-Security-Policy", Model.ContentSecurityPolicy.GeneratePolicy());
    // Context.Response.AddHeader("Content-Security-Policy", string.Format("default-src 'self';base-uri 'self';form-action 'self';object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline' ;font-src 'self' https://fonts.gstatic.com; script-src 'strict-dynamic' 'unsafe-inline' 'nonce-{0}' ;", Model.Nonce));
    Context.Response.AddHeader("X-XSS-Protection", "1; mode=block");
    //Context.Response.AddHeader("X-Frame-Options", "SAMEORIGIN");
    Context.Response.AddHeader("X-Content-Type-Options", "nosniff");
    Context.Response.AddHeader("Referrer-Policy", "same-origin");
    Context.Response.AddHeader("Permissions-Policy", "camera=self");
    Context.Response.AddHeader("Strict-Transport-Security", "max-age=2592000");
}